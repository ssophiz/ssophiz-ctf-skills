# CTFd control plane. Keep this token out of model prompts and worker containers.
SSOPHIZ_CTFD_URL=https://ctf.example.com
SSOPHIZ_CTFD_TOKEN=ctfd_replace_me

# A separate explicit gate is required before the verifier can submit flags.
SSOPHIZ_ENABLE_SUBMIT=0

# Optional Z.ai/OpenAI-compatible secondary provider.
# Coding Plan endpoint: https://api.z.ai/api/coding/paas/v4
# General prepaid/API endpoint: https://api.z.ai/api/paas/v4
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.3

# Optional generic provider slots. Configure only providers you explicitly use.
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
GROK_API_KEY=
