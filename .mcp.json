{
  "mcpServers": {
    "ctf-control": {
      "command": "scripts\\project-venv-python.cmd",
      "args": ["-m", "ssophiz_ctf.mcp_control"],
      "env": {
        "SSOPHIZ_CONFIG": "config/harness.json"
      }
    },
    "ctf-artifact": {
      "command": "scripts\\project-venv-python.cmd",
      "args": ["-m", "ssophiz_ctf.mcp_artifact"],
