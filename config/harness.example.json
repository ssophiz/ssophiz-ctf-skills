{
  "runtime": {
    "state_db": ".harness/state.db",
    "workspace_root": ".harness/workspaces",
    "worker_image": "ssophiz-ctf-worker:latest",
    "worker_network": "none",
    "max_parallel": 4,
    "default_timeout_minutes": 12
  },
  "orca": {
    "executable": "orca",
    "enabled": true
  },
  "ctfd": {
    "base_url": "${SSOPHIZ_CTFD_URL}",
    "token_env": "SSOPHIZ_CTFD_TOKEN"
  },
  "retrieval": {
    "roots": ["docs", "${SSOPHIZ_CTF_CORPUS}"],
    "collections": [
      {
        "name": "enki",
        "root": ".harness/corpora/enki/retrieval",
        "keywords": ["cce", "enki", "엔키", "codegate", "fiesta"]
      }
    ],
    "semantic_file_threshold": 80,
    "top_k": 5,
    "max_snippet_lines": 12
  },
  "profiles": {
    "codex_triage": {
      "adapter": "orca",
      "agent": "codex",
      "model": "gpt-6-astra",
      "effort": "low",
      "wave": 0,
      "focus": "Classify the supplied task and run at most three cheap decisive checks. Prefer metadata, known patterns, strings, imports, routes, and one mechanical extraction. Stop with QUICK, SOLVE, HARD, or BLOCKED plus one compact handoff."
    },
    "codex_fast": {
      "adapter": "orca",
      "agent": "codex",
      "model": "gpt-6-astra",
      "effort": "medium",
      "wave": 1,
      "focus": "Primary solver. Read the triage finding and artifacts first, pursue only the selected path, and save a minimal reproducible solver or one concrete blocker."
    },
    "codex_deep": {
      "adapter": "orca",
      "agent": "codex",
      "model": "gpt-6-astra",
      "effort": "xhigh",
      "wave": 2,
      "focus": "Escalation worker. Read existing findings and artifacts before acting, resolve the recorded blocker, and avoid repeating completed triage. Build a minimal reproducible solver or exploit."
    },
    "zai_probe": {
      "adapter": "openai_compatible",
      "base_url": "${ZAI_BASE_URL}",
      "api_key_env": "ZAI_API_KEY",
      "model": "${ZAI_MODEL}",
      "role": "misc",
      "wave": 0,
      "max_turns": 4,
      "focus": "Cheap secondary probe only. Inspect the compact state capsule and requested evidence span, test one hypothesis, and return one evidence-backed finding or BLOCKED. Do not replay the full task history."
    },
    "zai_review": {
      "adapter": "openai_compatible",
      "base_url": "${ZAI_BASE_URL}",
      "api_key_env": "ZAI_API_KEY",
      "model": "${ZAI_MODEL}",
      "role": "misc",
      "wave": 2,
      "max_turns": 8,
      "focus": "Independent second-model review for a concrete blocker or candidate. Read only the state capsule and explicitly referenced evidence. Prefer falsification and cross-checking over duplicate solving."
    },
    "ollama_local": {
      "adapter": "ollama",
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen3:14b",
      "role": "reverse",
      "wave": 1,
      "focus": "Perform a local independent review of decompilation notes, structures, and solver output.",
      "max_turns": 20
    }
  },
  "fast_lane": {
    "keywords": ["race condition", "timing race", "toctou", "scheduler", "workqueue", "realtime", "real-time", "websocket", "physics", "racing", "lap", "game", "bot"],
    "profiles": ["codex_fast", "codex_deep"]
  },
  "routes": {
    "pwn": ["codex_triage", "codex_fast", "codex_deep"],
    "reverse": ["codex_triage", "codex_fast", "codex_deep"],
    "malware": ["codex_triage", "codex_fast", "codex_deep"],
    "web": ["codex_triage", "codex_fast", "codex_deep"],
    "crypto": ["codex_triage", "codex_fast", "codex_deep"],
    "forensics": ["codex_triage", "codex_fast", "codex_deep"],
    "misc": ["codex_triage", "codex_fast", "codex_deep"]
  },
  "failover": {
    "enabled": false,
    "routes": {
      "pwn": ["zai_probe"],
      "reverse": ["zai_probe"],
      "malware": ["zai_probe"],
      "web": ["zai_probe"],
      "crypto": ["zai_probe"],
      "forensics": ["zai_probe"],
      "misc": ["zai_probe"]
    }
  },
  "mcp_roles": {
    "orchestrator": ["ctf-control", "ctf-artifact"],
    "pwn": ["ctf-control", "ctf-artifact", "ctf-sandbox", "ctf-ida"],
    "reverse": ["ctf-control", "ctf-artifact", "ctf-sandbox", "ctf-ida"],
    "malware": ["ctf-control", "ctf-artifact", "ctf-sandbox", "ctf-ida"],
    "web": ["ctf-control", "ctf-artifact", "ctf-sandbox", "ctf-web"],
    "crypto": ["ctf-control", "ctf-artifact", "ctf-sandbox"],
    "forensics": ["ctf-control", "ctf-artifact", "ctf-sandbox"],
    "misc": ["ctf-control", "ctf-artifact", "ctf-sandbox"],
    "verifier": ["ctf-verifier"]
  }
}
