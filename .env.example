# CTFd control plane. Keep this token out of model prompts and worker containers.
SSOPHIZ_CTFD_URL=https://ctf.example.com
SSOPHIZ_CTFD_TOKEN=ctfd_replace_me

# A separate explicit gate is required before the verifier can submit flags.
SSOPHIZ_ENABLE_SUBMIT=0

# Generic OpenAI-compatible provider slots. Configure only the providers you use.
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
GROK_API_KEY=
