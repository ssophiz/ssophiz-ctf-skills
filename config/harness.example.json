{
  "runtime": {
    "state_db": ".harness/state.db",
    "workspace_root": ".harness/workspaces",
    "worker_image": "ssophiz-ctf-worker:latest",
    "worker_network": "none",
    "max_parallel": 4,
    "default_timeout_minutes": 12
  },
  "orca": {
    "executable": "orca",
    "enabled": true
  },
  "ctfd": {
    "base_url": "${SSOPHIZ_CTFD_URL}",
    "token_env": "SSOPHIZ_CTFD_TOKEN"
  },
  "profiles": {
    "codex_fast": {
      "adapter": "orca",
      "agent": "codex",
      "model": "gpt-5.6-sol",
      "effort": "medium",
      "wave": 0,
      "focus": "Triage the supplied task using the category playbook. Test known patterns and mechanical extraction first, save raw evidence, and publish one compact handoff. Stop after a reproducible candidate or one concrete blocker."
    },
    "codex_deep": {
      "adapter": "orca",
      "agent": "codex",
      "model": "gpt-5.6-sol",
      "effort": "xhigh",
      "wave": 1,
      "focus": "Escalation worker. Read existing findings and artifacts before acting, resolve the recorded blocker, and avoid repeating completed triage. Build a minimal reproducible solver or exploit."
    },
    "claude_review": {
      "adapter": "orca",
      "agent": "claude",
      "model": "opus",
      "effort": "high",
      "wave": 2,
      "focus": "Optional independent reviewer. Read the existing evidence, challenge only the load-bearing assumption, and return a distinct bounded experiment or a concise confirmation."
    },
    "ollama_local": {
      "adapter": "ollama",
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen3:14b",
      "role": "reverse",
      "wave": 1,
      "focus": "Perform a local independent review of decompilation notes, structures, and solver output.",
      "max_turns": 20
    }
  },
  "routes": {
    "pwn": ["codex_fast", "codex_deep", "claude_review"],
    "reverse": ["codex_fast", "codex_deep", "claude_review"],
    "malware": ["codex_fast", "codex_deep", "claude_review"],
    "web": ["codex_fast", "codex_deep", "claude_review"],
    "crypto": ["codex_fast", "codex_deep", "claude_review"],
    "forensics": ["codex_fast", "codex_deep", "claude_review"],
    "misc": ["codex_fast", "codex_deep", "claude_review"]
  },
  "failover": {
    "enabled": false,
    "routes": {}
  },
  "mcp_roles": {
    "orchestrator": ["ctf-control", "ctf-artifact", "ctf-web"],
    "pwn": ["ctf-control", "ctf-artifact", "ctf-sandbox", "ctf-ida"],
    "reverse": ["ctf-control", "ctf-artifact", "ctf-sandbox", "ctf-ida", "search"],
    "malware": ["ctf-control", "ctf-artifact", "ctf-sandbox", "ctf-ida", "search"],
    "web": ["ctf-control", "ctf-artifact", "ctf-sandbox", "ctf-web"],
    "verifier": ["ctf-verifier"]
  }
}
